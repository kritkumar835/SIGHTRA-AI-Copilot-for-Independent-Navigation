# Gemini API Key (multimodal vision)
GEMINI_API_KEY=your_gemini_api_key_here

# Set to true to return pre-canned responses without calling external API
DEMO_MODE=false

# Optional model selection (e.g. gemini-2.5-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Port for FastAPI server
PORT=8000
HOST=0.0.0.0
